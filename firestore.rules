rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public, read-only catalog data — the site reads this directly from
    // the browser. Writes come from the scraper via the Admin SDK, which
    // bypasses these rules entirely, so `write: if false` is intentional.
    match /campsites/{campsiteId} {
      allow read: if true;
      allow write: if false;
    }

    match /source_adapters/{adapterId} {
      allow read: if true;
      allow write: if false;
    }

    // Town-level placeholder data for the map (see src/lib/townAggregates.ts)
    // — also public/read-only, also Admin-SDK-written only.
    match /town_aggregates/{townId} {
      allow read: if true;
      allow write: if false;
    }

    // campsite_index and geocode_cache are scraper-internal bookkeeping
    // (which URLs exist, geocode cache) — never read by the site, so they
    // stay fully locked down by the catch-all below rather than getting
    // their own `read: if true` rule.

    // Everything else (including any leftover data from other apps in this
    // project) stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
